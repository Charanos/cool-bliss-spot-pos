DATABASE_URL="postgresql://neondb_owner:npg_w6F5BySpjGsK@ep-old-violet-b2vtkv7x-pooler.c-6.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Set to 1 only for a deliberate review build that should serve the development data routes.
BLISS_DEV_DATA="LIwQiHy6DqGtWDLJfTzDVbpIcXP7q/lwicLKC1Rtp0WNazfBZGHB2/fxBrHQbvgw"

# WhatsApp alerts (docs/20). All four come from the venue's Meta developer app. Leave empty and
# alerts wait in Console, Settings, WhatsApp until they are set.
