{
  "name": "bliss",
  "version": "0.1.0",
  "private": true,
  "description": "Bliss, point of sale and stock control for Cool Bliss Spot",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack --port 3000",
    "build": "next build --webpack",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && node scripts/check-styles.mjs && node scripts/check-classes.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens:build": "tsx scripts/build-tokens.ts",
    "tokens:check": "tsx scripts/build-tokens.ts --check",
    "budget": "node scripts/bundle-budget.mjs",
    "ci": "pnpm tokens:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm budget",
    "db:seed": "tsx --env-file=.env.local scripts/db-seed.ts"
  },
  "dependencies": {
    "@bliss/db": "workspace:*",
    "@bliss/shared": "workspace:*",
    "@bliss/ui": "workspace:*",
    "@serwist/next": "^9.5.12",
    "@tabler/icons-react": "3.46.0",
    "@tanstack/react-virtual": "3.14.13",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "geist": "1.7.2",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "serwist": "^9.5.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@bliss/config": "workspace:*",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.3.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.3",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/rule-tester": "8.70.0",
    "@typescript-eslint/utils": "8.70.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.1",
    "globals": "17.12.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
