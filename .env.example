# Copy to .env.local (development) or the server's .env (production) and fill in.
# Never commit real values.

# ── Database ─────────────────────────────────────────────────────────────────
# Neon Postgres. The pooled URL (host contains -pooler) serves the app over WebSocket and HTTP.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ── Sign-in ──────────────────────────────────────────────────────────────────
# Signs every Console and station sign-in. Required in production; set it once and never change
# it (changing it signs everyone out). Make one with: openssl rand -base64 48
BLISS_SESSION_SECRET=

# Set to 1 only for a deliberate review build that should serve the development data routes.
BLISS_DEV_DATA=

# ── WhatsApp alerts (docs/20) ────────────────────────────────────────────────
# From the venue's Meta developer app. Leave empty and alerts wait in Console, Settings, WhatsApp
# until they are set. Webhook callback: https://cool-bliss-spot.co.ke/api/whatsapp/webhook
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Any long phrase; the same one is typed into the webhook settings in the Meta app.
# Make one with: openssl rand -hex 24
WHATSAPP_VERIFY_TOKEN=
# Optional: the Graph API version and the templates' language code.
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en

# ── Build ────────────────────────────────────────────────────────────────────
# Optional. Names the build, so stations know when a newer one is out (docs/16 section 4). Left
# unset, the build takes the commit it was built from, or the time when there is no git.
# BLISS_BUILD_ID=

# ── Development and rehearsal only. Leave all of these unset in production. ─
# 1 serves the development data routes, for a deliberate review build.
BLISS_DEV_DATA=
# memory keeps everything in memory instead of the database (tests, local rehearsal).
BLISS_STORE=
# handover, with BLISS_STORE=memory, runs the outlet as handed over to rehearse a first night.
BLISS_DATASET=
# The owner's PIN in that rehearsal (default 111111).
BLISS_OWNER_PIN=
# Points the WhatsApp sender at a mock server in tests.
WHATSAPP_API_BASE=
